  author = {Mitchell, Dann M. and Stone, Emma J. and Andrews, Oliver D. and Bamber, Jonathan L. and Bingham, Rory J. and Browse, Jo and Henry, Matthew and MacLeod, David M. and Morten, Joanne M. and Sauter, Christoph A. and Smith, Christopher J. and Thomas, James and Thomson, Stephen I. and Wilson, Jamie D. and the Bristol CMIP6 Data Hackathon Participants},
